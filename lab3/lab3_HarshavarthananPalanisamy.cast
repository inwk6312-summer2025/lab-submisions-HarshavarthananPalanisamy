[8539.68217, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[8539.682585, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[5d"]
[8539.682966, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[6d"]
[8539.683335, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'data-task9.yml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[7;4H"]
[8539.683757, "o", "data = yaml.safe_load(f)\r\u001b[9d"]
[8539.684166, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load Jinja2 environment\r\u001b[10d"]
[8539.684549, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
[8539.684969, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'template-task9.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[8539.685377, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate config for each router\r\u001b[14d"]
[8539.685794, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;4H"]
[8539.686209, "o", "config = template.render(router=router)\u001b[16;4H"]
[8539.686591, "o", "filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router['name']}_config.txt\"\u001b[17;4H"]
[8539.687007, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(filename, \u001b(B\u001b[0;1m\u001b[32m'w'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[18;8H"]
[8539.687395, "o", "f.write(config)\u001b[19;4H"]
[8539.687813, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration for {router['name']} written to {filename}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[2d"]
