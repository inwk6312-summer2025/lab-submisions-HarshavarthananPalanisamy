[8430.774098, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate config for each router\r\u001b[14d"]
[8430.774497, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;4H"]
[8430.774942, "o", "config = template.render(router=router)\u001b[16;4H"]
