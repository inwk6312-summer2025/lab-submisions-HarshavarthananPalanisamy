[9448.088675, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[9448.08907, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[5d"]
[9448.089501, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[6d"]
[9448.089904, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'data-task9.yml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[7;4H"]
[9448.090332, "o", "data = yaml.safe_load(f)\r\u001b[9d"]
[9448.090735, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load Jinja2 environment\r\u001b[10d"]
[9448.091156, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
