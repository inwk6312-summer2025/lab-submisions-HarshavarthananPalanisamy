[9448.091988, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate config for each router\r\u001b[14d"]
[9448.092387, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;4H"]
