[9219.382975, "o", "\u001b[2d"]
[9219.383367, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[9219.383786, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[5d"]
[9219.384168, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[6d"]
[9219.384571, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'data-task9.yml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[7;4H"]
[9219.385005, "o", "data = yaml.safe_load(f)\r\u001b[9d"]
[9219.385389, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load Jinja2 environment\r\u001b[10d"]
[9219.385805, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
[9219.386191, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'template-task9.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[9219.386601, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate config for each router\r\u001b[14d"]
[9219.387001, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;4H"]
[9219.387386, "o", "config = template.render(router=router)\u001b[16;4H"]
[9219.387795, "o", "filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router['name']}_config.txt\"\u001b[17;4H"]
[9219.388181, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(filename, \u001b(B\u001b[0;1m\u001b[32m'w'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[18;8H"]
