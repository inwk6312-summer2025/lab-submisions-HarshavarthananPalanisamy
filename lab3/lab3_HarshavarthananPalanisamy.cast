[7369.13757, "o", "\u001b[?12l\u001b[?25h"]
[7383.018787, "o", "\u001b[?25l"]
[7383.020397, "o", "\u001b[1;108H"]
[7383.021068, "o", "\u001b(B\u001b[0;7mModified"]
[7383.023358, "o", "\u001b(B\u001b[m\r\u001b[2d"]
[7383.023824, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[7383.024253, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[7383.024679, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[7383.025085, "o", "\u001b(B\u001b[0;1m\u001b[31m# Declare template environment\r\u001b[56d"]
[7383.025449, "o", "\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[6d"]
[7383.025838, "o", "\u001b[?12l\u001b[?25h"]
[7383.026242, "o", "\u001b[?25l"]
[7383.041176, "o", "ENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[7d"]
[7383.041838, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\r\u001b[8d"]
[7383.042313, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[7383.042722, "o", "network interface by looking for certain keywords in the name\r\u001b[10d"]
[7383.043174, "o", "\"\"\"\r\u001b[11d"]
[7383.043618, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[12d"]
[7383.044015, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[13d"]
[7383.04441, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[14d"]
[7383.044866, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[15d"]
[7383.045244, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[7383.045676, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[7383.046083, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[7383.046515, "o", "# template.render()\r\u001b[19d"]
[7383.046925, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[20d"]
[7383.047376, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[21d"]
[7383.047785, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[7383.048281, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[23d"]
[7383.048746, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[24d"]
[7383.049232, "o", "print(template.render(interface_list=interfaces))"]
[7383.049617, "o", "\u001b[?12l\u001b[?25h"]
