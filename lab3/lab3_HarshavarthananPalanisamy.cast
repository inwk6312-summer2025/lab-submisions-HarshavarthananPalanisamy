[9492.604305, "o", "\u001b[?25l"]
[9492.605159, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[6d"]
[9492.605586, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'data-task9.yml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[7d"]
[9492.605877, "o", "\u001b[?12l\u001b[?25h"]
[9492.606333, "o", "\u001b[?25l"]
[9492.607488, "o", "   "]
[9492.607874, "o", "data = yaml.safe_load(f)\r\u001b[9d"]
[9492.60827, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load Jinja2 environment\r\u001b[10d"]
[9492.608561, "o", "\u001b[39m\u001b(B\u001b[m"]
[9492.608822, "o", "\u001b[?12l\u001b[?25h"]
[9492.609252, "o", "\u001b[?25l"]
[9492.614302, "o", "env = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[11d"]
[9492.614718, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'template-task9.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[9492.615121, "o", "\u001b(B\u001b[0;1m\u001b[31m# Generate config for each router\r\u001b[14d"]
[9492.615568, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m data[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m]:\u001b[15;4H"]
[9492.616, "o", "config = template.render(router=router)\u001b[16;4H"]
[9492.61639, "o", "filename = f\u001b(B\u001b[0;1m\u001b[32m\"{router['name']}_config.txt\"\u001b[17;4H"]
[9492.616825, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(filename, \u001b(B\u001b[0;1m\u001b[32m'w'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[18;8H"]
[9492.617228, "o", "f.write(config)\u001b[19;4H"]
[9492.617649, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration for {router['name']} written to {filename}\"\u001b[39m\u001b(B\u001b[m)"]
[9492.618029, "o", "\u001b[?12l\u001b[?25h"]
[9494.183516, "o", "\u001b[?25l\u001b[57;17H             \u001b(B\u001b[0;7mM-D\u001b(B\u001b[m DOS Format\u001b[15X\u001b[57;59H\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Append      \u001b[81G       \u001b(B\u001b[0;7mM-B\u001b(B\u001b[m Backup File\u001b[K\u001b[58;2H\u001b(B\u001b[0;7mC\u001b(B\u001b[m Cancel\u001b[17G             \u001b(B\u001b[0;7mM-M\u001b(B\u001b[m Mac Format\u001b[15X\u001b[58;59H\u001b(B\u001b[0;7mM-P\u001b(B\u001b[m Prepend\u001b[18X\u001b[58;88H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Files\u001b[K\r\u001b[56d\u001b(B\u001b[0;7mFile Name to Write: task9.py                                                                                         \u001b[56;1H\u001b(B\u001b[m\u001b[56;29H\u001b[?12l\u001b[?25h"]
