[9492.597937, "o", "\u001b[?25l"]
[9492.598507, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[9492.598877, "o", "\u001b[?12l\u001b[?25h"]
[9492.600721, "o", "\u001b[?25l"]
