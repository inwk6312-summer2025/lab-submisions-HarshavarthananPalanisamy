[1660.433285, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[1660.43381, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[1660.434335, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[6d"]
[1660.434911, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[7d"]
[1660.435452, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[8d"]
[1660.436032, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[9d"]
[1660.436597, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[10d"]
[1660.437173, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[11d"]
[1660.437708, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url):\u001b[12;5H"]
[1660.438349, "o", "url = BASE_URL + append_url\u001b[13;5H"]
[1660.438898, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[14;5H"]
[1660.439455, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[15;5H"]
[1660.440001, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[16;5H"]
[1660.440561, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[17;5H"]
