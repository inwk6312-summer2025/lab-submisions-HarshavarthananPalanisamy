[2119.088374, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[15;5H"]
[2119.088939, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[16;5H"]
[2119.089504, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[17;5H"]
