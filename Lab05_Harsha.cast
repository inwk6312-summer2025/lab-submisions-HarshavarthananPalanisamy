[3751.486511, "o", "\u001b(B\u001b[0;1m\u001b[31m# Credentials\r\u001b[14d"]
[3751.487108, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[15d"]
[3751.48766, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[17d"]
[3751.488238, "o", "\u001b[31m# Load YAML\r\u001b[18d"]
[3751.488822, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config.yaml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[19;5H"]
[3751.489426, "o", "config = yaml.safe_load(f)\r\u001b[21d"]
[3751.489991, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interface_config\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[22;5H"]
[3751.490584, "o", "BASE_URL = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/\"\u001b[23;5H"]
[3751.491181, "o", "\u001b[39m\u001b(B\u001b[murl = BASE_URL + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m]\u001b[24;5H"]
[3751.49177, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[25;5H"]
[3751.492325, "o", "headers = {\u001b[26;9H"]
[3751.492903, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[27;9H"]
[3751.493469, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[28;5H"]
[3751.494071, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[30d\b"]
[3751.494637, "o", "data = {\u001b[31;9H"]
[3751.495234, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[32;13H"]
[3751.495853, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[33;13H"]
[3751.496455, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via RESTCONF and YAML\"\u001b[39m\u001b(B\u001b[m,\u001b[34;13H"]
[3751.497037, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[35;13H"]
[3751.497597, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[36;13H"]
[3751.49818, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[37;17H"]
[3751.49874, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[38;21H"]
[3751.499353, "o", "{\u001b[39;25H"]
[3751.499926, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m],\u001b[40;25H"]
[3751.500578, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m]\u001b[41;21H"]
