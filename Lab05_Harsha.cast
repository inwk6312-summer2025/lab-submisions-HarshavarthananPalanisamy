[5335.144129, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[5335.14466, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[5335.145194, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[6d"]
[5335.145745, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[8d"]
[5335.146313, "o", "\u001b(B\u001b[0;1m\u001b[31m# Setup logging\r\u001b[9d"]
[5335.146867, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[5335.147399, "o", "\u001b(B\u001b[0;1m\u001b[31m# RESTCONF credentials\r\u001b[12d"]
[5335.147939, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[13d"]
[5335.148474, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[15d"]
[5335.149029, "o", "\u001b[31m# Load YAML configuration\r\u001b[16d"]
[5335.149572, "o", "\u001b[36mdef\u001b[34m load_yaml_config\u001b[39m\u001b(B\u001b[m(file_path):\u001b[17;5H"]
[5335.150103, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[18d"]
[5335.150652, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(file_path) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[19;13H"]
[5335.151201, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m yaml.safe_load(f)\u001b[20;5H"]
[5335.151756, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[21;9H"]
[5335.152295, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error loading YAML file: {e}\"\u001b[39m\u001b(B\u001b[m)\u001b[22;9H"]
[5335.15286, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[35mNone\r\u001b[24d"]
[5335.153385, "o", "\u001b[31m# Function to configure interface on a router\r\u001b[25d"]
[5335.153941, "o", "\u001b[36mdef\u001b[34m set_interface_config\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[26;5H"]
[5335.154469, "o", "BASE_URL = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/\"\u001b[27;5H"]
[5335.155049, "o", "\u001b[39m\u001b(B\u001b[murl = BASE_URL + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m]\u001b[28;5H"]
[5335.155598, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[29;5H"]
