[4582.085316, "o", "\u001b[39m\u001b(B\u001b[m    }\u001b[K\r\u001b[15d"]
[4582.085794, "o", "    data = {\u001b[K\u001b[16;8H"]
[4582.086269, "o", "\u001b[1K "]
