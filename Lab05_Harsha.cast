[2359.149683, "o", "\r\u001b[12d"]
[2359.150237, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[13d"]
