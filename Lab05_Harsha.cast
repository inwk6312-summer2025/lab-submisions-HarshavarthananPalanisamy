[4389.404192, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[5d"]
[4389.404728, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[6d"]
[4389.405215, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[7d"]
[4389.405749, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[8d"]
[4389.406266, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[10d"]
[4389.406827, "o", "\u001b(B\u001b[0;1m\u001b[31m# Setup logging\r\u001b[11d"]
[4389.407351, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[4389.407902, "o", "\u001b(B\u001b[0;1m\u001b[31m# Credentials\r\u001b[14d"]
[4389.408409, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[15d"]
[4389.408957, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[17d"]
[4389.409456, "o", "\u001b[31m# Load YAML\r\u001b[18d"]
[4389.409989, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config.yaml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[19;5H"]
[4389.410506, "o", "config = yaml.safe_load(f)\r\u001b[21d"]
[4389.411078, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interface_config\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[22;5H"]
[4389.411587, "o", "BASE_URL = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/\"\u001b[23;5H"]
[4389.412142, "o", "\u001b[39m\u001b(B\u001b[murl = BASE_URL + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m]\u001b[24;5H"]
[4389.412652, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[25;5H"]
[4389.413189, "o", "headers = {\u001b[26;9H"]
[4389.413687, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[27;9H"]
[4389.414255, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[28;5H"]
[4389.41476, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[30d\b"]
[4389.415319, "o", "data = {\u001b[31;9H"]
[4389.415802, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[32;13H"]
[4389.416358, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[33;13H"]
[4389.41688, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via RESTCONF and YAML\"\u001b[39m\u001b(B\u001b[m,\u001b[34;13H"]
[4389.417427, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[35;13H"]
[4389.417826, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[36;13H"]
[4389.418438, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[37;17H"]
[4389.418848, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[38;21H"]
[4389.419277, "o", "{\u001b[39;25H"]
[4389.419715, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m],\u001b[40;25H"]
[4389.420104, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m]\u001b[41;21H"]
[4389.420921, "o", "}\u001b[42;17H"]
[4389.42134, "o", "]\u001b[43;13H"]
[4389.421731, "o", "},\u001b[44d\b\b"]
[4389.422149, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[45;9H"]
[4389.422555, "o", "}\u001b[46;5H"]
[4389.422958, "o", "}\u001b[48d\b"]
[4389.423353, "o", "response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\u001b[49;5H"]
[4389.423734, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[50;9H"]
[4389.424172, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configured {interface['name']} on {host} successfully.\"\u001b[39m\u001b(B\u001b[m)\u001b[51;5H"]
[4389.424562, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[52d\b"]
[4389.424975, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to configure {interface['name']} on {host}. Code: {response.status_code}, Message: {\u001b[39m\u001b(B\u001b[0;7m>\u001b[54;1H"]
[4389.425375, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through routers and apply configs\r\u001b[55d"]
[4389.425796, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config[\u001b(B\u001b[0;1m\u001b[32m\"routers\"\u001b[39m\u001b(B\u001b[m]:\r\u001b[2d"]
[4389.427204, "o", "\u001b[?12l\u001b[?25h"]
[4463.417553, "o", "\u001b[?25l\u001b[1;107H\u001b(B\u001b[0;7mModified\u001b(B\u001b[m\u001b[2;55r\u001b[55;1H\n\u001b[1;58r\u001b[55;5Hhost = router[\u001b(B\u001b[0;1m\u001b[32m\"mgmt_ip\"\u001b[39m\u001b(B\u001b[m]\r\u001b[2d\u001b[?12l\u001b[?25h"]
