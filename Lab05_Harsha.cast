[4582.078449, "o", "\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[5d"]
[4582.078982, "o", "\u001b(B\u001b[0;1m\u001b[31m# Function to configure interface on a router\r\u001b[6d"]
[4582.079526, "o", "\u001b[36mdef\u001b[34m set_interface_config\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[7;5H"]
[4582.080043, "o", "BASE_URL = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/\"\r\u001b[8d"]
[4582.080584, "o", "\u001b[39m\u001b(B\u001b[m    url = BASE_URL + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m]\r\u001b[9d"]
