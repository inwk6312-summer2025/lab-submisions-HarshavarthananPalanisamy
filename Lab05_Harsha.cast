[5335.156641, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[31;9H"]
[5335.157175, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[32;5H"]
[5335.157733, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[34d\b"]
[5335.158276, "o", "data = {\u001b[35;9H"]
