[4582.101532, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m config:\u001b[47;9H"]
