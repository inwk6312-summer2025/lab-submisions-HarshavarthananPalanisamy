[3182.307171, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[6d"]
[3182.307739, "o", "\u001b[?12l\u001b[?25h"]
[3182.308746, "o", "\u001b[?25l"]
[3182.309943, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[7d"]
[3182.310504, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[8d"]
[3182.311041, "o", "\u001b[?12l\u001b[?25h"]
[3182.313819, "o", "\u001b[?25l\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[10d"]
[3182.314397, "o", "\u001b[?12l\u001b[?25h"]
[3182.3175, "o", "\u001b[?25l\u001b(B\u001b[0;1m\u001b[31m# Setup logging\r\u001b[11d"]
[3182.318064, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[3182.31859, "o", "\u001b[?12l\u001b[?25h"]
[3182.321095, "o", "\u001b[?25l"]
[3182.323231, "o", "\u001b[13d"]
[3182.325416, "o", "\u001b(B\u001b[0;1m\u001b[31m# Credentials\r\u001b[14d"]
[3182.325935, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[15d"]
[3182.326456, "o", "\u001b[39m\u001b(B\u001b[m"]
[3182.327013, "o", "\u001b[?12l\u001b[?25h"]
[3182.327545, "o", "\u001b[?25l"]
[3182.37333, "o", "\u001b[2;56r\u001b[56;1H"]
[3182.374371, "o", "\u001b[3S\u001b[1;58r\u001b[12;1H"]
[3182.375006, "o", "PASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[14d"]
[3182.375566, "o", "\u001b[31m# Load YAML\r\u001b[15d"]
[3182.376122, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config.yaml'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[16;5H"]
[3182.376679, "o", "config = yaml.safe_load(f)\r\u001b[18d"]
[3182.377234, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interface_config\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[19;5H"]
[3182.377866, "o", "BASE_URL = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/\"\u001b[20;5H"]
[3182.378433, "o", "\u001b[39m\u001b(B\u001b[murl = BASE_URL + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m]\u001b[21;5H"]
[3182.378977, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[22;5H"]
[3182.379535, "o", "headers = {\u001b[23;9H"]
[3182.380089, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[24;9H"]
[3182.380803, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[25;5H"]
[3182.38134, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[27d\b"]
[3182.381885, "o", "data = {\u001b[28;9H"]
[3182.38246, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[29;13H"]
[3182.383046, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[30;13H"]
[3182.383569, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via RESTCONF and YAML\"\u001b[39m\u001b(B\u001b[m,\u001b[31;13H"]
[3182.384136, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[32;13H"]
[3182.384686, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[33;13H"]
[3182.385199, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[34;17H"]
[3182.385735, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[35;21H"]
[3182.386255, "o", "{\u001b[36;25H"]
[3182.386856, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m],\u001b[37;25H"]
[3182.387382, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m]\u001b[38;21H"]
[3182.387897, "o", "}\u001b[39;17H"]
[3182.388443, "o", "]\u001b[40;13H"]
[3182.388983, "o", "},\u001b[41d\b\b"]
[3182.389543, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[42;9H"]
[3182.390097, "o", "}\u001b[43;5H"]
[3182.390616, "o", "}\u001b[45d\b"]
[3182.391179, "o", "response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\u001b[46;5H"]
[3182.391751, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[47;9H"]
[3182.392279, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configured {interface['name']} on {host} successfully.\"\u001b[39m\u001b(B\u001b[m)\u001b[48;5H"]
[3182.392844, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[49d\b"]
[3182.393248, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to configure {interface['name']} on {host}. Code: {response.status_code}, Message: {\u001b[39m\u001b(B\u001b[0;7m>\u001b[51;1H"]
[3182.393917, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through routers and apply configs\r\u001b[52d"]
[3182.394328, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config[\u001b(B\u001b[0;1m\u001b[32m\"routers\"\u001b[39m\u001b(B\u001b[m]:\u001b[53;5H"]
[3182.394737, "o", "host = router[\u001b(B\u001b[0;1m\u001b[32m\"mgmt_ip\"\u001b[39m\u001b(B\u001b[m]\u001b[54;5H"]
[3182.395147, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m iface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m router[\u001b(B\u001b[0;1m\u001b[32m\"interfaces\"\u001b[39m\u001b(B\u001b[m]:\u001b[55;9H"]
[3182.395558, "o", "set_interface_config(host, iface)"]
[3182.395925, "o", "\u001b[?12l\u001b[?25h"]
[3186.416857, "o", "\u001b[?25l\u001b[57;17H"]
